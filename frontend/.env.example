# Base URL of the deployed backend API.
# Leave empty to use the same origin (Vite dev proxy, or a reverse proxy).
# Example: VITE_API_URL=https://philosophical-debates-backend.onrender.com
VITE_API_URL=

# Supabase project settings (the anon key is public and safe in the frontend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=